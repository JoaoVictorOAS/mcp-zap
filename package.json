{
  "name": "whatsapp-mcp",
  "version": "1.0.0",
  "description": "WhatsApp Model Context Protocol (MCP) server with SQLite history and group support",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "whatsapp-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "auth": "tsx src/auth.ts",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "whatsapp",
    "baileys",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@whiskeysockets/baileys": "^6.7.13",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
